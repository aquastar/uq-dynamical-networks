[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip = .git*,node_modules,package-lock.json,*.css,.codespellrc,previous-deck.html
check-hidden = true
# Ignore super long lines -- must be minimized etc, acronyms
# and some near hit variables
ignore-regex = ^.{120,}|\b(currentY|FOM)\b
# surnames in the references and short identifiers in the code
ignore-words-list = hart,handel,mannor,bu,drawin,trun,fpr,nd,te,dout
